<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0">

    <!-- TOP ORANGE BACKGROUND -->

    <View
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:background="#FF7A00"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CLOSE BUTTON -->

    <androidx.cardview.widget.CardView
        android:id="@+id/btnClose"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:src="@drawable/ic_close" />

    </androidx.cardview.widget.CardView>

    <!-- SUCCESS CARD -->

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp"
            android:background="#FFFFFF">

            <!-- SUCCESS ICON -->

            <androidx.cardview.widget.CardView
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:cardCornerRadius="75dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF1E5">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="35dp"
                    android:src="@drawable/ic_succes" />

            </androidx.cardview.widget.CardView>

            <!-- TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Payment Success! 🎉"
                android:textColor="#111111"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- SUBTITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Pesanan kamu sedang diproses.\nTerima kasih sudah memesan di Sushilicious 🍣"
                android:textColor="#777777"
                android:textSize="16sp" />

            <!-- STATUS BOX -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="#FFF6EF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Pesanan sedang disiapkan"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- BUTTON -->

            <Button
                android:id="@+id/btnHome"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#FF7A00"
                android:text="Back To Home"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>